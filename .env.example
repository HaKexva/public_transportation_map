# Production (Railway, Docker, etc.): set ONE of the following — not both with mismatched values.
#
# Option A (recommended on Railway): generate and set SECRET_KEY_BASE, then remove RAILS_MASTER_KEY
#   bin/rails secret
SECRET_KEY_BASE=
#
# Option B: set RAILS_MASTER_KEY to the exact contents of config/master.key (32 hex chars).
# Must match the key used to encrypt config/credentials.yml.enc in git. After a key rotation,
# update Railway or delete RAILS_MASTER_KEY and use Option A instead.
# RAILS_MASTER_KEY=

# PostgreSQL connection (required in production).
# Example: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Optional overrides for local development (when DATABASE_URL is unset):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_NAME=public_transportation_map_development

# Optional: separate databases for Solid Cache / Queue / Cable (defaults to DATABASE_URL)
# CACHE_DATABASE_URL=
# QUEUE_DATABASE_URL=
# CABLE_DATABASE_URL=

# Google Maps basemap + embedded Street View (Maps JavaScript API) and server-side
# Geocoding for sidebar landmarks. Billing must be enabled on the Cloud project,
# plus Maps JavaScript API (Street View uses it). Without billing, Google tiles
# show “For development purposes only”. Restrict JS use by HTTP referrer;
# Geocoding runs server-side. Leave blank to hide Google basemap / embedded
# Street View (external Street View links and stop search still work).
GOOGLE_MAPS_API_KEY=

# CARTO 底圖（light/dark_nolabels）。未設定時圖磚會顯示「API KEY REQUIRED」浮水印。
# 免費申請：https://carto.com/basemaps （此 key 會出現在瀏覽器的圖磚請求中）
CARTO_API_KEY=

# TDX 運輸資料流通服務（匯入臺鐵、高鐵、捷運時刻表；即時 ETA／通阻）
# 註冊：https://tdx.transportdata.tw
# Set TDX_ENABLED=0 to pause every outbound TDX call (live + imports) without
# deleting credentials. Default is on when unset.
TDX_ENABLED=0
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
